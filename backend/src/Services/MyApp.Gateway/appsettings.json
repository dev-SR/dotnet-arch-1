{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "GatewayPublicUrl": "http://localhost:5100",
    "AuthBaseUrl": "http://localhost:5101",
    "OrdersBaseUrl": "http://localhost:5103",
    "InvoicesBaseUrl": "http://localhost:5102",
    "ShippingBaseUrl": "http://localhost:5104"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "products-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/products/{**catch-all}" }
      },
      "search-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/search/{**catch-all}" }
      },
      "cart-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/cart/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/orders/{**catch-all}" }
      },
      "invoices-route": {
        "ClusterId": "invoices",
        "Match": { "Path": "/invoices/{**catch-all}" }
      },
      "shipping-route": {
        "ClusterId": "shipping",
        "Match": { "Path": "/shipping/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5101/" }
        }
      },
      "orders": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5103/" }
        }
      },
      "invoices": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5102/" }
        }
      },
      "shipping": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5104/" }
        }
      }
    }
  }
}
