{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "GatewayPublicUrl": "http://localhost:5100",
    "AuthBaseUrl": "http://localhost:5101",
    "InvoicesBaseUrl": "http://localhost:5102"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "products-route": {
        "ClusterId": "auth",
        "Match": { "Path": "/products/{**catch-all}" }
      },
      "invoices-route": {
        "ClusterId": "invoices",
        "Match": { "Path": "/invoices/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5101/" }
        }
      },
      "invoices": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5102/" }
        }
      }
    }
  }
}
