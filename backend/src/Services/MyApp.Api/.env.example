# --- JWT ---
# Generate: openssl rand -base64 48
Jwt__Secret=uIqdROcht3Rmk5WcICgyvWiYr1kmj/FMA3ajChJTpIeY94voZ6VQJDLakHLzecuq
Jwt__Issuer=secure-api
Jwt__Audience=secure-api-clients
Jwt__AccessTokenMinutes=10
Jwt__RefreshTokenDays=7

# --- Database ---
ConnectionStrings__Default=Data Source=app.db

# --- Rate limiting (requests per minute, per client IP) ---
RateLimit__GlobalPerMinute=120
RateLimit__AuthPerMinute=5

# --- Dev-only seed admin (leave empty to skip). Must satisfy the password rules. ---
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=ChangeMe-12345

Seed__UserEmail=user@example.com
Seed__UserPassword=ChangeMe-12345
